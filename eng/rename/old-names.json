{
  "version": 1,
  "decision": "D079.11: build errors for old package IDs in the graph and for renamed MSBuild names and environment variables, through 1.0.x, removed in 2.0",
  "family": {
    "token": "RunicCommandLine",
    "buildName": "Runic Command Line",
    "helpLinkBase": "$(RunicDiagnosticsHelpLinkBase)",
    "diagnostics": {
      "packages": "RCLI7001",
      "msbuild": "RCLI7002",
      "environment": "RCLI7003"
    },
    "skipCondition": "'$(_TargetAssemblyProjectName)' == '' and !$(MSBuildProjectName.EndsWith('_wpftmp'))",
    "root": "../..",
    "generator": "eng/rename/old-names.mjs",
    "input": "eng/rename/old-names.json",
    "outputs": [
      "packages/dotnet/Runic.CommandLine/buildTransitive/Runic.CommandLine.RenamedNames.targets"
    ]
  },
  "packages": [],
  "msbuild": [],
  "environment": []
}
