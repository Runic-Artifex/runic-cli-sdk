{
  "implementations": {
    "dotnet-commandline": {
      "corpus": "commandline/1",
      "roles": ["parser", "reader", "writer", "presenter"],
      "build": ["dotnet", "build", "${ROOT}/tests/dotnet/Runic.CommandLine.Conformance/Runic.CommandLine.Conformance.csproj", "-c", "${CONFIGURATION}", "-nologo", "-v", "q", "-clp:ErrorsOnly"],
      "command": ["dotnet", "run", "--no-build", "--project", "${ROOT}/tests/dotnet/Runic.CommandLine.Conformance/Runic.CommandLine.Conformance.csproj", "-c", "${CONFIGURATION}"],
      "env": { "DOTNET_NOLOGO": "1", "DOTNET_CLI_TELEMETRY_OPTOUT": "1" },
      "status": "status/dotnet.json"
    }
  }
}
