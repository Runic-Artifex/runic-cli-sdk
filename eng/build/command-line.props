<Project>
  <PropertyGroup>
    <RunicBuildModeProperty>RunicCommandLineBuildMode</RunicBuildModeProperty>
    <RunicBuildMode>$(RunicCommandLineBuildMode)</RunicBuildMode>
    <RunicPolicyIcon>$(MSBuildThisFileDirectory)../branding/command-line/icon.png</RunicPolicyIcon>
    <PackageTags Condition="'$(PackageTags)' == ''">runic-artifex;command-line;cli;dotnet;nativeaot</PackageTags>
  </PropertyGroup>
  <Import Project="common.props" />
  <PropertyGroup>
    <RunicCommandLineBuildMode>$(RunicBuildMode)</RunicCommandLineBuildMode>
    <RunicCommandLineDefaultTargetFramework>$(RunicTargetFramework)</RunicCommandLineDefaultTargetFramework>
    <RunicCommandLineGeneratorTargetFramework>$(RunicTargetFramework)</RunicCommandLineGeneratorTargetFramework>
  </PropertyGroup>
</Project>
