<Project>
  <PropertyGroup>
    <!--
      Development is the approachable inner loop. Verification is selected by CI
      and eng/verify.ps1 for locked restores and release-grade analysis.
    -->
    <RunicCommandLineBuildMode Condition="'$(RunicCommandLineBuildMode)' == '' and '$(CI)' == 'true'">Verification</RunicCommandLineBuildMode>
    <RunicCommandLineBuildMode Condition="'$(RunicCommandLineBuildMode)' == ''">Development</RunicCommandLineBuildMode>
    <RunicCommandLineVerificationBuild Condition="'$(RunicCommandLineBuildMode)' == 'Verification'">true</RunicCommandLineVerificationBuild>
    <RunicCommandLineVerificationBuild Condition="'$(RunicCommandLineVerificationBuild)' == ''">false</RunicCommandLineVerificationBuild>

    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors Condition="'$(RunicCommandLineVerificationBuild)' == 'true'">true</TreatWarningsAsErrors>
    <TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)' == ''">false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RepositoryType>git</RepositoryType>
    <Authors>RunicArtifex</Authors>
    <Company>RunicArtifex</Company>
    <Copyright>Copyright (c) 2026 Viktor Jannicke</Copyright>
    <RepositoryUrl>https://github.com/Runic-Artifex/runic-command-line</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Runic-Artifex/runic-command-line</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Repository projects keep updateable lock files; only Verification locks them. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(RunicCommandLineVerificationBuild)' == 'true'">true</RestoreLockedMode>
    <RestoreLockedMode Condition="'$(RestoreLockedMode)' == ''">false</RestoreLockedMode>
    <NuGetAudit Condition="'$(RunicCommandLineVerificationBuild)' == 'true'">true</NuGetAudit>
    <NuGetAudit Condition="'$(NuGetAudit)' == ''">false</NuGetAudit>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RunicCommandLineDefaultTargetFramework>net10.0</RunicCommandLineDefaultTargetFramework>
    <RunicCommandLineCompatibilityTargetFramework>net10.0</RunicCommandLineCompatibilityTargetFramework>
    <RunicCommandLineGeneratorTargetFramework>net10.0</RunicCommandLineGeneratorTargetFramework>
  </PropertyGroup>
</Project>
