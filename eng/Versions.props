<Project>
  <PropertyGroup>
    <RunicCommandLineVersion>1.0.0-rc.1</RunicCommandLineVersion>
    <!-- Last published release; package validation compares candidates with it. -->
    <RunicCommandLinePackageValidationBaselineVersion>0.11.0</RunicCommandLinePackageValidationBaselineVersion>
    <Version Condition="'$(Version)' == ''">$(RunicCommandLineVersion)</Version>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(RunicCommandLineVersion)</PackageVersion>
  </PropertyGroup>
</Project>
