<Project>
  <PropertyGroup>
    <RunicCommandLineVersion>0.7.0-preview.2</RunicCommandLineVersion>
    <!-- Last published release; package validation compares candidates with it. -->
    <RunicCommandLinePackageValidationBaselineVersion>0.7.0-preview.1</RunicCommandLinePackageValidationBaselineVersion>
    <Version Condition="'$(Version)' == ''">$(RunicCommandLineVersion)</Version>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(RunicCommandLineVersion)</PackageVersion>
  </PropertyGroup>
</Project>
