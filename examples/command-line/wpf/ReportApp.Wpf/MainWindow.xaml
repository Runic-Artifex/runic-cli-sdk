<Window x:Class="Runic.CommandLine.Examples.ReportApp.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory" Height="320" Width="420">
    <DockPanel Margin="12">
        <Button DockPanel.Dock="Top" Content="Load items" Command="{Binding LoadCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
        <ListBox ItemsSource="{Binding Items}" DisplayMemberPath="Name" />
    </DockPanel>
</Window>
