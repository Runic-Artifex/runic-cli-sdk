<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../../eng/build/command-line.props" />
  <!-- Console subsystem executable: the recommended way to give a WPF application a CLI. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>reportcli</AssemblyName>
    <RootNamespace>Runic.CommandLine.Examples.ReportApp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ReportApp.Commands/ReportApp.Commands.csproj" />
  </ItemGroup>
  <Import Project="../../../../eng/build/command-line.targets" />
</Project>
