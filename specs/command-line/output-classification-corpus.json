{
  "formatVersion": 1,
  "protocol": "runic.commandline/1",
  "environmentVariable": "RUNIC_COMMANDLINE_OUTPUT",
  "cases": [
    { "id": "output.default.absent", "args": ["status"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": null }, "expected": { "kind": "output-mode", "mode": "human", "source": "default" } },
    { "id": "output.default.empty-environment", "args": ["status"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": "" }, "expected": { "kind": "output-mode", "mode": "human", "source": "default" } },
    { "id": "output.environment.human", "args": ["status"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": "human" }, "expected": { "kind": "output-mode", "mode": "human", "source": "environment" } },
    { "id": "output.environment.json", "args": ["status"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": "json" }, "expected": { "kind": "output-mode", "mode": "json", "source": "environment" } },
    { "id": "output.environment.case-insensitive", "args": ["status"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": "JsOn" }, "expected": { "kind": "output-mode", "mode": "json", "source": "environment" } },
    { "id": "output.environment.whitespace-invalid", "args": ["status"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": " json " }, "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1010", "kind": "invalid-output-mode", "tokenIndex": 0 }] } },
    { "id": "output.environment.unknown-invalid", "args": ["status"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": "xml" }, "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1010", "kind": "invalid-output-mode", "tokenIndex": 0 }] } },
    { "id": "output.explicit.separated-human", "args": ["status", "--output", "human"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": "json" }, "expected": { "kind": "output-mode", "mode": "human", "source": "explicit-argument" } },
    { "id": "output.explicit.separated-json", "args": ["status", "--output", "json"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": "human" }, "expected": { "kind": "output-mode", "mode": "json", "source": "explicit-argument" } },
    { "id": "output.explicit.equals", "args": ["status", "--output=json"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": null }, "expected": { "kind": "output-mode", "mode": "json", "source": "explicit-argument" } },
    { "id": "output.explicit.case-insensitive", "args": ["status", "--output=JSON"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": null }, "expected": { "kind": "output-mode", "mode": "json", "source": "explicit-argument" } },
    { "id": "output.explicit.valid-ignores-invalid-environment", "args": ["status", "--output=json"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": "xml" }, "expected": { "kind": "output-mode", "mode": "json", "source": "explicit-argument" } },
    { "id": "output.explicit.missing-value", "args": ["status", "--output"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": "json" }, "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1003", "kind": "missing-option-value", "tokenIndex": 2 }] } },
    { "id": "output.explicit.empty-equals-invalid", "args": ["status", "--output="], "environment": { "RUNIC_COMMANDLINE_OUTPUT": "json" }, "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1010", "kind": "invalid-output-mode", "tokenIndex": 1 }] } },
    { "id": "output.explicit.unknown-invalid", "args": ["status", "--output", "xml"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": "json" }, "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1010", "kind": "invalid-output-mode", "tokenIndex": 2 }] } },
    { "id": "output.explicit.duplicate", "args": ["status", "--output", "json", "--output=human"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": null }, "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1007", "kind": "duplicate-option", "tokenIndex": 3 }] } },
    { "id": "output.terminator.disables-explicit", "args": ["echo", "--", "--output=json"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": "human" }, "expected": { "kind": "output-mode", "mode": "human", "source": "environment" } },
    { "id": "output.terminator.default", "args": ["echo", "--", "--output", "json"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": null }, "expected": { "kind": "output-mode", "mode": "human", "source": "default" } },
    { "id": "output.alias.json", "args": ["status", "--json"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": "human" }, "expected": { "kind": "output-mode", "mode": "json", "source": "explicit-argument" } },
    { "id": "output.alias.before-command", "args": ["--json", "status"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": null }, "expected": { "kind": "output-mode", "mode": "json", "source": "explicit-argument" } },
    { "id": "output.alias.ignores-invalid-environment", "args": ["status", "--json"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": "xml" }, "expected": { "kind": "output-mode", "mode": "json", "source": "explicit-argument" } },
    { "id": "output.alias.conflicts-with-selector", "args": ["status", "--json", "--output", "human"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": null }, "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1016", "kind": "conflicting-output-selector", "tokenIndex": 2 }] } },
    { "id": "output.alias.conflicts-with-earlier-selector", "args": ["status", "--output=json", "--json"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": null }, "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1016", "kind": "conflicting-output-selector", "tokenIndex": 2 }] } },
    { "id": "output.alias.duplicate", "args": ["status", "--json", "--json"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": null }, "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1007", "kind": "duplicate-option", "tokenIndex": 2 }] } },
    { "id": "output.alias.rejects-value", "args": ["status", "--json=true"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": null }, "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1004", "kind": "unexpected-option-value", "tokenIndex": 1 }] } },
    { "id": "output.alias.terminator-disables", "args": ["echo", "--", "--json"], "environment": { "RUNIC_COMMANDLINE_OUTPUT": null }, "expected": { "kind": "output-mode", "mode": "human", "source": "default" } }
  ]
}
