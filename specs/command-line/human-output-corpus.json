{
  "formatVersion": 1,
  "protocol": "runic.commandline/1",
  "applicationName": "tool",
  "catalogs": {
    "app": {
      "jsonOutputAlias": "--json",
      "commands": [
        {"path": ["report"], "aliases": [], "options": [{"id": "old", "long": "--old", "aliases": [], "arity": {"minimum": 0, "maximum": 0}, "repeat": "error"}], "arguments": []},
        {"path": ["copy"], "aliases": [], "options": [], "arguments": [{"id": "source", "arity": {"minimum": 1, "maximum": 1}}, {"id": "destination", "arity": {"minimum": 1, "maximum": 1}}]}
      ]
    }
  },
  "cases": [
    {"id": "human.text", "catalog": "app", "args": ["report"], "outcome": {"success": true, "payloadType": "runic.text/1", "payload": "done", "diagnostics": []}, "expected": {"exitCode": 0, "stdout": "done\n", "stderr": ""}},
    {"id": "human.text-ending-in-line-feed", "catalog": "app", "args": ["report"], "outcome": {"success": true, "payloadType": "runic.text/1", "payload": "done\n", "diagnostics": []}, "expected": {"exitCode": 0, "stdout": "done\n", "stderr": ""}},
    {"id": "human.text-empty", "catalog": "app", "args": ["report"], "outcome": {"success": true, "payloadType": "runic.text/1", "payload": "", "diagnostics": []}, "expected": {"exitCode": 0, "stdout": "\n", "stderr": ""}},
    {"id": "human.text-lines", "catalog": "app", "args": ["report"], "outcome": {"success": true, "payloadType": "runic.text/1", "payload": "one\ntwo", "diagnostics": []}, "expected": {"exitCode": 0, "stdout": "one\ntwo\n", "stderr": ""}},
    {"id": "human.unit", "catalog": "app", "args": ["report"], "outcome": {"success": true, "payloadType": "runic.unit/1", "diagnostics": []}, "expected": {"exitCode": 0, "stdout": "", "stderr": ""}},
    {"id": "human.success-diagnostics", "catalog": "app", "args": ["report", "--old"], "outcome": {"success": true, "payloadType": "runic.text/1", "payload": "done", "diagnostics": [{"code": "RCLI8001", "kind": "deprecated-option", "commandPath": ["report"], "messageKey": "diagnostics.deprecated-option", "message": "The --old option is deprecated.", "phase": "execution", "severity": "warning", "tokenIndex": null, "arguments": []}]}, "expected": {"exitCode": 0, "stdout": "done\n", "stderr": "The --old option is deprecated.\n"}},
    {"id": "human.unit-diagnostics", "catalog": "app", "args": ["report"], "outcome": {"success": true, "payloadType": "runic.unit/1", "diagnostics": [{"code": "RCLI8001", "kind": "deprecated-option", "commandPath": ["report"], "messageKey": "diagnostics.deprecated-option", "message": "The --old option is deprecated.", "phase": "execution", "severity": "warning", "tokenIndex": null, "arguments": []}]}, "expected": {"exitCode": 0, "stdout": "", "stderr": "The --old option is deprecated.\n"}},
    {"id": "human.success-diagnostic-help-link", "catalog": "app", "args": ["report"], "outcome": {"success": true, "payloadType": "runic.text/1", "payload": "done", "diagnostics": [{"code": "RCLI8001", "kind": "deprecated-option", "commandPath": ["report"], "messageKey": "diagnostics.deprecated-option", "message": "The --old option is deprecated.", "phase": "execution", "severity": "warning", "tokenIndex": null, "arguments": [], "helpUri": "https://docs.example.com/warnings#RCLI8001"}]}, "expected": {"exitCode": 0, "stdout": "done\n", "stderr": "The --old option is deprecated.\nHelp for RCLI8001: https://docs.example.com/warnings#RCLI8001\n"}},
    {"id": "human.diagnostic-line-breaks", "catalog": "app", "args": ["report"], "outcome": {"success": true, "payloadType": "runic.text/1", "payload": "done", "diagnostics": [{"code": "RCLI8001", "kind": "deprecated-option", "commandPath": ["report"], "messageKey": "diagnostics.deprecated-option", "message": "\nThe --old option \r\nis\u0007deprecated.\n", "phase": "execution", "severity": "warning", "tokenIndex": null, "arguments": []}]}, "expected": {"exitCode": 0, "stdout": "done\n", "stderr": "The --old option\nis deprecated.\n"}},
    {"id": "human.failure", "catalog": "app", "args": ["report"], "outcome": {"success": false, "category": "command-failure", "fault": {"code": "RCLI8002", "message": "The export could not be completed.", "details": [], "retryable": false}, "diagnostics": []}, "expected": {"exitCode": 1, "stdout": "", "stderr": "The export could not be completed.\n"}},
    {"id": "human.failure-multiline-fault", "catalog": "app", "args": ["report"], "outcome": {"success": false, "category": "command-failure", "fault": {"code": "RCLI8002", "message": "The export failed.\nThe disk is full.", "details": [], "retryable": false}, "diagnostics": []}, "expected": {"exitCode": 1, "stdout": "", "stderr": "The export failed.\nThe disk is full.\n"}},
    {"id": "human.failure-diagnostics", "catalog": "app", "args": ["report"], "outcome": {"success": false, "category": "validation", "fault": {"code": "RCLI8003", "message": "The report is invalid.", "details": [], "retryable": false}, "diagnostics": [{"code": "RCLI8004", "kind": "missing-title", "commandPath": ["report"], "messageKey": "diagnostics.missing-title", "message": "The report has no title.", "phase": "execution", "severity": "error", "tokenIndex": null, "arguments": []}, {"code": "RCLI8005", "kind": "empty-section", "commandPath": ["report"], "messageKey": "diagnostics.empty-section", "message": "Section 2 is empty.", "phase": "execution", "severity": "warning", "tokenIndex": null, "arguments": []}]}, "expected": {"exitCode": 2, "stdout": "", "stderr": "The report has no title.\nSection 2 is empty.\nThe report is invalid.\n"}},
    {"id": "human.failure-diagnostic-describes-fault", "catalog": "app", "args": ["report"], "outcome": {"success": false, "category": "command-failure", "fault": {"code": "RCLI8002", "message": "The export could not be completed.", "details": [], "retryable": false}, "diagnostics": [{"code": "RCLI8002", "kind": "export-failed", "commandPath": ["report"], "messageKey": "diagnostics.export-failed", "message": "The export could not be completed.", "phase": "execution", "severity": "error", "tokenIndex": null, "arguments": []}]}, "expected": {"exitCode": 1, "stdout": "", "stderr": "The export could not be completed.\n"}},
    {"id": "human.failure-fault-help-link", "catalog": "app", "args": ["report"], "outcome": {"success": false, "category": "unavailable", "fault": {"code": "RCLI8002", "message": "The export could not be completed.", "details": [], "retryable": false, "helpUri": "https://docs.example.com/errors#RCLI8002"}, "diagnostics": []}, "expected": {"exitCode": 1, "stdout": "", "stderr": "The export could not be completed.\nHelp for RCLI8002: https://docs.example.com/errors#RCLI8002\n"}},
    {"id": "human.failure-help-link-once", "catalog": "app", "args": ["report"], "outcome": {"success": false, "category": "command-failure", "fault": {"code": "RCLI8002", "message": "The export could not be completed.", "details": [], "retryable": false, "helpUri": "https://docs.example.com/errors#RCLI8002"}, "diagnostics": [{"code": "RCLI8002", "kind": "export-failed", "commandPath": ["report"], "messageKey": "diagnostics.export-failed", "message": "The export could not be completed.", "phase": "execution", "severity": "error", "tokenIndex": null, "arguments": [], "helpUri": "https://docs.example.com/errors#RCLI8002"}]}, "expected": {"exitCode": 1, "stdout": "", "stderr": "The export could not be completed.\nHelp for RCLI8002: https://docs.example.com/errors#RCLI8002\n"}},
    {"id": "human.failure-help-link-translated", "catalog": "app", "args": ["report"], "outcome": {"success": false, "category": "command-failure", "fault": {"code": "RCLI8002", "message": "The export could not be completed.", "details": [], "retryable": false, "helpUri": "https://docs.example.com/errors#RCLI8002"}, "diagnostics": []}, "texts": {"hints.help-link": "Hilfe zu {0}: {1}"}, "expected": {"exitCode": 1, "stdout": "", "stderr": "The export could not be completed.\nHilfe zu RCLI8002: https://docs.example.com/errors#RCLI8002\n"}},
    {"id": "human.failure-help-link-translation-without-link", "catalog": "app", "args": ["report"], "outcome": {"success": false, "category": "command-failure", "fault": {"code": "RCLI8002", "message": "The export could not be completed.", "details": [], "retryable": false, "helpUri": "https://docs.example.com/errors#RCLI8002"}, "diagnostics": []}, "texts": {"hints.help-link": "Siehe die Dokumentation zu {0}."}, "expected": {"exitCode": 1, "stdout": "", "stderr": "The export could not be completed.\nHelp for RCLI8002: https://docs.example.com/errors#RCLI8002\n"}},
    {"id": "human.failure-help-link-translation-technical", "catalog": "app", "args": ["report"], "outcome": {"success": false, "category": "command-failure", "fault": {"code": "RCLI8002", "message": "The export could not be completed.", "details": [], "retryable": false, "helpUri": "https://docs.example.com/errors#RCLI8002"}, "diagnostics": []}, "texts": {"hints.help-link": "Siehe C:\\docs\\{0}: {1}"}, "expected": {"exitCode": 1, "stdout": "", "stderr": "The export could not be completed.\nHelp for RCLI8002: https://docs.example.com/errors#RCLI8002\n"}},
    {"id": "human.failure-own-output", "catalog": "app", "args": ["report"], "outcome": {"success": false, "category": "command-failure", "fault": {"code": "RCLI8002", "message": "The export could not be completed.", "details": [], "retryable": false}, "diagnostics": [{"code": "RCLI8001", "kind": "deprecated-option", "commandPath": ["report"], "messageKey": "diagnostics.deprecated-option", "message": "The --old option is deprecated.", "phase": "execution", "severity": "warning", "tokenIndex": null, "arguments": []}], "humanOutput": "Nothing to export.\n"}, "expected": {"exitCode": 1, "stdout": "Nothing to export.\n", "stderr": "The --old option is deprecated.\nThe export could not be completed.\n"}},
    {"id": "human.usage-failure", "catalog": "app", "args": ["copy", "a", "b"], "outcome": {"success": false, "category": "usage", "fault": {"code": "RCLI8006", "message": "The source and destination are the same.", "details": [], "retryable": false}, "diagnostics": []}, "expected": {"exitCode": 2, "stdout": "", "stderr": "The source and destination are the same.\nUsage: tool copy <source> <destination> [options]\nRun \"tool copy --help\" for more information.\n"}},
    {"id": "human.usage-failure-own-output", "catalog": "app", "args": ["copy", "a", "b"], "outcome": {"success": false, "category": "usage", "fault": {"code": "RCLI8006", "message": "The source and destination are the same.", "details": [], "retryable": false}, "diagnostics": [], "humanOutput": "a and b are one file.\n"}, "expected": {"exitCode": 2, "stdout": "a and b are one file.\n", "stderr": "The source and destination are the same.\n"}},
    {"id": "human.parse-error", "catalog": "app", "args": ["copy", "a"], "outcome": {"success": true, "payloadType": "runic.text/1", "payload": "unused", "diagnostics": []}, "expected": {"exitCode": 2, "stdout": "", "stderr": "The <destination> argument is missing.\nUsage: tool copy <source> <destination> [options]\nRun \"tool copy --help\" for more information.\n"}},
    {"id": "human.parse-error-at-root", "catalog": "app", "args": ["nosuch"], "outcome": {"success": true, "payloadType": "runic.text/1", "payload": "unused", "diagnostics": []}, "expected": {"exitCode": 2, "stdout": "", "stderr": "The command 'nosuch' is not recognized.\nUsage: tool <command> [options]\nRun \"tool --help\" for more information.\n"}},
    {"id": "human.host-failure-hint", "catalog": "app", "args": ["report"], "outcome": {"success": false, "category": "host-failure", "fault": {"code": "RCLI5000", "message": "The command could not be completed.", "details": [], "retryable": false}, "diagnostics": []}, "expected": {"exitCode": 3, "stdout": "", "stderr": "The command could not be completed. Set RUNIC_COMMANDLINE_DEBUG=1 to write the exception to stderr.\n"}}
  ]
}
