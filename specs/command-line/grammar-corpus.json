    { "id": "grammar.option.choice-invalid", "args": ["deploy", "--target", "prod", "--level", "fast"], "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1015", "kind": "invalid-choice", "tokenIndex": 5, "arguments": ["--level", "debug, release, gr\u00f6\u00dfe"], "binding": "level" }] } },
    { "id": "grammar.option.choice-after-other-errors", "args": ["deploy", "--level", "fast"], "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1012", "kind": "missing-required-option", "tokenIndex": 3, "arguments": ["--target", "deploy"], "binding": "target" }] } },
