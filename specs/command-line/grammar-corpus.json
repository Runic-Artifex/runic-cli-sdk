    { "id": "grammar.option.environment-appended", "args": ["deploy", "--level", "debug", "--target", "prod"], "environment": { "SAMPLE_TOKEN": "secret" }, "expected": { "kind": "invocation", "commandPath": ["deploy"], "options": [{ "id": "level", "values": ["debug"] }, { "id": "target", "values": ["prod"] }, { "id": "token", "values": ["secret"] }], "arguments": [] } },
    { "id": "grammar.option.command-line-overrides-environment", "args": ["deploy", "--target", "prod", "--token", "given"], "environment": { "SAMPLE_TOKEN": "secret" }, "expected": { "kind": "invocation", "commandPath": ["deploy"], "options": [{ "id": "target", "values": ["prod"] }, { "id": "token", "values": ["given"] }], "arguments": [] } },
