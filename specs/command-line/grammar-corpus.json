{
  "formatVersion": 1,
  "protocol": "runic.commandline/1",
  "tokenModel": "pre-tokenized-string-array",
  "catalog": {
    "jsonOutputAlias": "--json",
    "globalOptions": [
      { "id": "profile", "long": "--profile", "aliases": [], "arity": { "minimum": 1, "maximum": 1 }, "repeat": "error" }
    ],
    "commands": [
      {
        "path": ["status"],
        "aliases": ["stat"],
        "options": [
          { "id": "verbose", "long": "--verbose", "aliases": ["-v", "/verbose"], "arity": { "minimum": 0, "maximum": 0 }, "repeat": "error" }
        ],
        "arguments": []
      },
      {
        "path": ["cache"],
        "aliases": ["c"],
        "options": [],
        "arguments": []
      },
      {
        "path": ["cache", "clear"],
        "aliases": ["purge"],
        "options": [
          { "id": "all", "long": "--all", "aliases": ["-a"], "arity": { "minimum": 0, "maximum": 0 }, "repeat": "error" }
        ],
        "arguments": []
      },
      {
        "path": ["export"],
        "aliases": [],
        "options": [
          { "id": "encoding", "long": "--encoding", "aliases": ["-e"], "arity": { "minimum": 1, "maximum": 1 }, "repeat": "error" },
          { "id": "tag", "long": "--tag", "aliases": ["-t"], "arity": { "minimum": 1, "maximum": 1 }, "repeat": "append" },
          { "id": "force", "long": "--force", "aliases": ["/force"], "arity": { "minimum": 0, "maximum": 0 }, "repeat": "error" }
        ],
        "arguments": [
          { "id": "input", "arity": { "minimum": 1, "maximum": 1 } }
        ]
      },
      {
        "path": ["copy"],
        "aliases": [],
        "options": [],
        "arguments": [
          { "id": "source", "arity": { "minimum": 1, "maximum": 1 } },
          { "id": "destination", "arity": { "minimum": 1, "maximum": 1 } }
        ]
      },
      {
        "path": ["echo"],
        "aliases": [],
        "options": [],
        "arguments": [
          { "id": "text", "arity": { "minimum": 0, "maximum": "unbounded" } }
        ]
      },
      {
        "path": ["run"],
        "aliases": [],
        "options": [],
        "arguments": [
          { "id": "program", "arity": { "minimum": 1, "maximum": 1 } },
          { "id": "arguments", "arity": { "minimum": 0, "maximum": "unbounded" } }
        ]
      },
      {
        "path": ["deploy"],
        "aliases": [],
        "options": [
          { "id": "target", "long": "--target", "aliases": [], "arity": { "minimum": 1, "maximum": 1 }, "repeat": "error", "required": true },
          { "id": "level", "long": "--level", "aliases": [], "arity": { "minimum": 1, "maximum": 1 }, "repeat": "error", "choices": ["debug", "release", "gr\u00f6\u00dfe"] },
          { "id": "offset", "long": "--offset", "aliases": [], "arity": { "minimum": 1, "maximum": 1 }, "repeat": "error", "acceptsNegativeNumbers": true },
          { "id": "token", "long": "--token", "aliases": [], "arity": { "minimum": 1, "maximum": 1 }, "repeat": "error", "environmentVariable": "SAMPLE_TOKEN" },
          { "id": "dry-run", "long": "--dry-run", "aliases": [], "arity": { "minimum": 0, "maximum": 0 }, "repeat": "error", "environmentVariable": "SAMPLE_DRY_RUN" },
          { "id": "strategy", "long": "--strategy", "aliases": [], "arity": { "minimum": 1, "maximum": 1 }, "repeat": "error", "choices": ["fast", "safe"], "environmentVariable": "SAMPLE_STRATEGY" }
        ],
        "arguments": [
          { "id": "count", "arity": { "minimum": 0, "maximum": 1 }, "acceptsNegativeNumbers": true }
        ]
      },
      {
        "path": ["remote"],
        "aliases": [],
        "group": true,
        "options": [],
        "arguments": []
      },
      {
        "path": ["plot"],
        "aliases": [],
        "options": [],
        "arguments": [
          { "id": "points", "arity": { "minimum": 1, "maximum": 2 } },
          { "id": "delta", "arity": { "minimum": 1, "maximum": 1 }, "acceptsNegativeNumbers": true }
        ]
      }
    ]
  },
  "cases": [
    { "id": "grammar.empty-input", "args": [], "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1002", "kind": "unknown-command", "tokenIndex": 0 }] } },
    { "id": "grammar.command.canonical", "args": ["status"], "expected": { "kind": "invocation", "commandPath": ["status"], "options": [], "arguments": [] } },
    { "id": "grammar.command.case-sensitive", "args": ["Status"], "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1002", "kind": "unknown-command", "tokenIndex": 0 }] } },
    { "id": "grammar.command.empty-token", "args": [""], "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1002", "kind": "unknown-command", "tokenIndex": 0 }] } },
    { "id": "grammar.command.alias", "args": ["stat"], "expected": { "kind": "invocation", "commandPath": ["status"], "options": [], "arguments": [] } },
