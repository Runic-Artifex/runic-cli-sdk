    { "id": "grammar.argument.empty-token-preserved", "args": ["echo", "", "tail"], "expected": { "kind": "invocation", "commandPath": ["echo"], "options": [], "arguments": [{ "id": "text", "values": ["", "tail"] }] } },
    { "id": "grammar.argument.unicode-preserved", "args": ["echo", "Résumé", "東京", "😀", "é"], "expected": { "kind": "invocation", "commandPath": ["echo"], "options": [], "arguments": [{ "id": "text", "values": ["Résumé", "東京", "😀", "é"] }] } },
    { "id": "grammar.argument.absolute-unix-path", "args": ["export", "/tmp/input.db"], "expected": { "kind": "invocation", "commandPath": ["export"], "options": [], "arguments": [{ "id": "input", "values": ["/tmp/input.db"] }] } },
    { "id": "grammar.argument.absolute-windows-path", "args": ["export", "C:\\data\\input.db"], "expected": { "kind": "invocation", "commandPath": ["export"], "options": [], "arguments": [{ "id": "input", "values": ["C:\\data\\input.db"] }] } },
    { "id": "grammar.terminator.leading-hyphen-data", "args": ["run", "--", "-tool", "--flag"], "expected": { "kind": "invocation", "commandPath": ["run"], "options": [], "arguments": [{ "id": "program", "values": ["-tool"] }, { "id": "arguments", "values": ["--flag"] }] } },
    { "id": "grammar.terminator.slash-alias-is-data", "args": ["export", "--", "/force"], "expected": { "kind": "invocation", "commandPath": ["export"], "options": [], "arguments": [{ "id": "input", "values": ["/force"] }] } },
    { "id": "grammar.terminator.empty-data", "args": ["echo", "--", ""], "expected": { "kind": "invocation", "commandPath": ["echo"], "options": [], "arguments": [{ "id": "text", "values": [""] }] } },
    { "id": "grammar.help.root-long", "args": ["--help"], "expected": { "kind": "help", "commandPath": [] } },
    { "id": "grammar.help.root-short", "args": ["-h"], "expected": { "kind": "help", "commandPath": [] } },
