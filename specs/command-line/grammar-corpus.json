    { "id": "grammar.output-alias.before-command", "args": ["--json", "status", "-v"], "expected": { "kind": "invocation", "commandPath": ["status"], "options": [{ "id": "verbose", "values": [] }], "arguments": [] } },
    { "id": "grammar.output-alias.before-help", "args": ["--json", "--help"], "expected": { "kind": "help", "commandPath": [] } },
