    { "id": "grammar.option.required-missing", "args": ["deploy", "--level", "debug"], "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1012", "kind": "missing-required-option", "tokenIndex": 3, "arguments": ["--target", "deploy"], "binding": "target" }] } },
