    { "id": "grammar.command.nested-aliases", "args": ["c", "purge", "-a"], "expected": { "kind": "invocation", "commandPath": ["cache", "clear"], "options": [{ "id": "all", "values": [] }], "arguments": [] } },
    { "id": "grammar.option.long-flag", "args": ["status", "--verbose"], "expected": { "kind": "invocation", "commandPath": ["status"], "options": [{ "id": "verbose", "values": [] }], "arguments": [] } },
    { "id": "grammar.option.short-flag", "args": ["status", "-v"], "expected": { "kind": "invocation", "commandPath": ["status"], "options": [{ "id": "verbose", "values": [] }], "arguments": [] } },
    { "id": "grammar.option.slash-alias", "args": ["status", "/verbose"], "expected": { "kind": "invocation", "commandPath": ["status"], "options": [{ "id": "verbose", "values": [] }], "arguments": [] } },
    { "id": "grammar.option.long-separated", "args": ["export", "--encoding", "json", "input.db"], "expected": { "kind": "invocation", "commandPath": ["export"], "options": [{ "id": "encoding", "values": ["json"] }], "arguments": [{ "id": "input", "values": ["input.db"] }] } },
    { "id": "grammar.option.long-equals", "args": ["export", "--encoding=json", "input.db"], "expected": { "kind": "invocation", "commandPath": ["export"], "options": [{ "id": "encoding", "values": ["json"] }], "arguments": [{ "id": "input", "values": ["input.db"] }] } },
    { "id": "grammar.option.short-separated", "args": ["export", "-e", "json", "input.db"], "expected": { "kind": "invocation", "commandPath": ["export"], "options": [{ "id": "encoding", "values": ["json"] }], "arguments": [{ "id": "input", "values": ["input.db"] }] } },
    { "id": "grammar.option.empty-separated-value", "args": ["export", "--encoding", "", "input.db"], "expected": { "kind": "invocation", "commandPath": ["export"], "options": [{ "id": "encoding", "values": [""] }], "arguments": [{ "id": "input", "values": ["input.db"] }] } },
    { "id": "grammar.option.empty-equals-value", "args": ["export", "--encoding=", "input.db"], "expected": { "kind": "invocation", "commandPath": ["export"], "options": [{ "id": "encoding", "values": [""] }], "arguments": [{ "id": "input", "values": ["input.db"] }] } },
    { "id": "grammar.option.repeat-append", "args": ["export", "--tag", "one", "-t", "two", "input.db"], "expected": { "kind": "invocation", "commandPath": ["export"], "options": [{ "id": "tag", "values": ["one", "two"] }], "arguments": [{ "id": "input", "values": ["input.db"] }] } },
    { "id": "grammar.option.repeat-identical-preserved", "args": ["export", "--tag", "same", "--tag", "same", "input.db"], "expected": { "kind": "invocation", "commandPath": ["export"], "options": [{ "id": "tag", "values": ["same", "same"] }], "arguments": [{ "id": "input", "values": ["input.db"] }] } },
    { "id": "grammar.option.duplicate-scalar", "args": ["export", "--encoding", "json", "-e", "yaml", "input.db"], "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1007", "kind": "duplicate-option", "tokenIndex": 3, "binding": "encoding" }] } },
    { "id": "grammar.option.duplicate-flag", "args": ["status", "-v", "--verbose"], "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1007", "kind": "duplicate-option", "tokenIndex": 2, "binding": "verbose" }] } },
    { "id": "grammar.option.missing-value", "args": ["export", "--encoding"], "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1003", "kind": "missing-option-value", "tokenIndex": 2, "binding": "encoding" }] } },
    { "id": "grammar.option.flag-rejects-equals", "args": ["status", "--verbose=true"], "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1004", "kind": "unexpected-option-value", "tokenIndex": 1, "binding": "verbose" }] } },
    { "id": "grammar.option.unknown-long", "args": ["status", "--quiet"], "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1001", "kind": "unknown-option", "tokenIndex": 1 }] } },
    { "id": "grammar.option.former-output-selector", "args": ["status", "--output", "json"], "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1001", "kind": "unknown-option", "tokenIndex": 1 }] } },
    { "id": "grammar.option.former-output-selector-before-command", "args": ["--output", "json", "status"], "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1002", "kind": "unknown-command", "tokenIndex": 0 }] } },
    { "id": "grammar.option.short-bundle-unsupported", "args": ["status", "-vh"], "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1008", "kind": "unsupported-short-bundle", "tokenIndex": 1 }] } },
    { "id": "grammar.argument.required", "args": ["export", "input.db"], "expected": { "kind": "invocation", "commandPath": ["export"], "options": [], "arguments": [{ "id": "input", "values": ["input.db"] }] } },
    { "id": "grammar.argument.missing", "args": ["copy", "source.txt"], "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1005", "kind": "missing-argument", "tokenIndex": 2, "arguments": ["<destination>"], "binding": "destination" }] } },
    { "id": "grammar.argument.missing-all", "args": ["copy"], "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1005", "kind": "missing-argument", "tokenIndex": 1, "arguments": ["<source>"], "binding": "source" }] } },
    { "id": "grammar.argument.missing-before-optional", "args": ["run"], "expected": { "kind": "error", "diagnostics": [{ "code": "RCLI1005", "kind": "missing-argument", "tokenIndex": 1, "arguments": ["<program>"], "binding": "program" }] } },
