<Project>
  <Import Project="eng/Versions.props" Condition="'$(RunicCommandLineVersion)' == ''" />
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Runic.Translations" Version="0.6.0-preview.1" />
    <PackageVersion Include="Runic.Translations.Build" Version="0.6.0-preview.1" />
    <!-- Spectre.Console types are public API of Runic.CommandLine.Spectre, and Spectre.Console is pre-1.0, so the
         range stops before its next minor. Move it in a Command Line minor after testing; see eng/release/README.md. -->
    <PackageVersion Include="Spectre.Console" Version="[0.57.2, 0.58)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <!-- TUnit test projects (see CONTRIBUTING.md); keep TUnit.Core and TUnit.Engine on one version. -->
    <PackageVersion Include="TUnit.Core" Version="1.73.19" />
    <PackageVersion Include="TUnit.Engine" Version="1.73.19" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>
</Project>
