<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/command-line.props" />
  <PropertyGroup>
    <!-- A TUnit test application on Microsoft.Testing.Platform: run it with dotnet run or the built executable. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Runic.CommandLine.Tests</AssemblyName>
    <RootNamespace>Runic.CommandLine.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Program.cs runs the signal child before it starts the test application. -->
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TUnitImplicitUsings>false</TUnitImplicitUsings>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit.Core" />
    <PackageReference Include="TUnit.Engine" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <ProjectReference Include="../../../packages/dotnet/Runic.CommandLine.Testing/Runic.CommandLine.Testing.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.CommandLine.Spectre/Runic.CommandLine.Spectre.csproj" />
    <!-- The code-range test scans every package in eng/build/shipping-projects.props, so each must be referenced. -->
    <ProjectReference Include="../../../packages/dotnet/Runic.CommandLine.Processes/Runic.CommandLine.Processes.csproj" />
    <ProjectReference Include="../../../packages/dotnet/Runic.CommandLine.Generators/Runic.CommandLine.Generators.csproj" OutputItemType="Analyzer" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <ProjectReference Include="..\..\..\packages\dotnet\Runic.CommandLine\Runic.CommandLine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\specs\command-line\grammar-corpus.json" Link="Corpus\grammar-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\specs\command-line\output-classification-corpus.json" Link="Corpus\output-classification-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\specs\command-line\protocol\**\*.json" Link="Corpus\protocol\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../../../eng/build/command-line.targets" />
</Project>
