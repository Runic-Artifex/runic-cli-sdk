    <RootNamespace>WebUIToolkit.CommandLine.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WebUIToolkit.CommandLine.Abstractions\WebUIToolkit.CommandLine.Abstractions.csproj" />
