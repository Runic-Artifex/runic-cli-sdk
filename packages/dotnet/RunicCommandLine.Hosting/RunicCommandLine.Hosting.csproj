<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicCommandLineDefaultTargetFramework)</TargetFramework>
    <RunicCommandLineShippingProject>true</RunicCommandLineShippingProject>
    <AssemblyName>RunicCommandLine.Hosting</AssemblyName>
    <RootNamespace>RunicCommandLine.Hosting</RootNamespace>
    <PackageId>RunicCommandLine.Hosting</PackageId>
    <Description>Neutral command-line launch classification and execution bridge for application hosts.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RunicCommandLine\RunicCommandLine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PublicAPI.Unshipped.txt" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
