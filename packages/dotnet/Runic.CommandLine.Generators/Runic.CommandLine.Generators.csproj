<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/command-line.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicCommandLineGeneratorTargetFramework)</TargetFramework>
    <AssemblyName>Runic.CommandLine.Generators</AssemblyName>
    <RootNamespace>Runic.CommandLine.Generators</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS1041 warns that a net10.0 analyzer cannot load in a compiler host running on .NET Framework.
         The generator deliberately targets the repository's .NET 10 framework and ships in a net10.0-only
         package, so it requires a Roslyn host on .NET 10 (the .NET 10 SDK compiler and IDE language servers).
         A build whose compiler runs on .NET Framework, such as Visual Studio's MSBuild without the SDK's
         compiler, cannot load it: it reports CS8032 and the generated catalog is missing. -->
    <NoWarn>$(NoWarn);RS1041</NoWarn>
    <!-- Help links name the release tag; see eng/build/release-links.targets. -->
    <RunicGenerateReleaseLinks>true</RunicGenerateReleaseLinks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Analyzer-authoring rules, including release tracking for the generator's diagnostic IDs (RS2000-RS2008). -->
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <!-- The compiler API the generator builds against. A compiler refuses a generator that references a newer
         Microsoft.CodeAnalysis than its own (CS9057), so Directory.Packages.props pins the version shipped by the
         lowest supported .NET 10 SDK feature band (10.0.1xx: Roslyn 5.0.0), not the building SDK's compiler.
         The compiler host supplies these assemblies at run time; they are not package dependencies. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
  <Import Project="../../../eng/build/command-line.targets" />
</Project>
