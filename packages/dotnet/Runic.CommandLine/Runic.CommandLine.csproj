<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/command-line.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicCommandLineDefaultTargetFramework)</TargetFramework>
    <RunicCommandLineShippingProject>true</RunicCommandLineShippingProject>
    <AssemblyName>Runic.CommandLine</AssemblyName>
    <RootNamespace>Runic.CommandLine</RootNamespace>
    <PackageId>Runic.CommandLine</PackageId>
    <Description>Parser-neutral command catalog, execution, host integration, and output kernel for .NET applications.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <!-- CommandFailureData's encoder overrides TextEncoder's pointer-based members. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Catalog validation issues link to their catalog entry at the release tag; see eng/build/release-links.targets. -->
    <RunicGenerateReleaseLinks>true</RunicGenerateReleaseLinks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Runic.CommandLine.Generators/Runic.CommandLine.Generators.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="../Runic.CommandLine.Generators/bin/$(Configuration)/$(RunicCommandLineGeneratorTargetFramework)/Runic.CommandLine.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs" />
  </ItemGroup>

  <!-- Framework text catalog. translations/ holds the sources of the runic-command-line catalog (en, de), which the
       Runic.Translations.CommandLine adapter compiles from this package, and text-keys.json, written from
       CommandTextKeys.All after each build. The package carries them as plain data under translations/: no contentFiles
       and no props, so nothing flows into a consuming project, and this package does not reference Runic.Translations.
       tests/dotnet/Runic.CommandLine.TextCatalog.Tests checks that every key has en and de text. -->
  <ItemGroup>
    <None Update="translations/runic.json;translations/*.rmf2" Pack="true" PackagePath="translations/%(Filename)%(Extension)" />
    <!-- Keys the built-in catalog deliberately leaves to the framework's own text; text-keys.json gives them
         "message": null. RCLI4001 shows its diagnostics.prompt-* text, which a catalog message would replace. -->
    <RunicTextKeyWithoutCatalogMessage Include="faults.RCLI4001" />
    <ProjectReference Include="../../../eng/tools/text-keys/TextKeysWriter.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed;IlcTreatWarningsAsErrors" />
  </ItemGroup>
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_RunicPackTextKeys</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="_RunicTextKeysPaths">
    <PropertyGroup>
      <RunicTextKeysFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)text-keys.json'))</RunicTextKeysFile>
      <_RunicTextKeysWriter>$(RunicCommandLineRoot)eng/tools/text-keys/bin/$(Configuration)/$(RunicTargetFramework)/Runic.CommandLine.TextKeysWriter.dll</_RunicTextKeysWriter>
    </PropertyGroup>
  </Target>

  <Target Name="_RunicWriteTextKeys"
          AfterTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="_RunicTextKeysPaths"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <!-- Not incremental: a pack passes PackageVersion without recompiling, and the file records it. It takes ~0.1 s. -->
    <Exec Command="&quot;$([MSBuild]::ValueOrDefault('$(DOTNET_HOST_PATH)', 'dotnet'))&quot; &quot;$(_RunicTextKeysWriter)&quot; &quot;@(IntermediateAssembly->'%(FullPath)')&quot; &quot;$(RunicTextKeysFile)&quot; &quot;$(PackageVersion)&quot; @(RunicTextKeyWithoutCatalogMessage->'&quot;%(Identity)&quot;', ' ')" />
    <ItemGroup>
      <FileWrites Include="$(RunicTextKeysFile)" />
    </ItemGroup>
  </Target>

  <!-- The path of the generated text-keys.json, for the catalog coverage test. -->
  <Target Name="GetRunicTextKeysFile" DependsOnTargets="_RunicTextKeysPaths" Returns="$(RunicTextKeysFile)" />

  <Target Name="_RunicPackTextKeys" DependsOnTargets="_RunicTextKeysPaths">
    <Error Condition="!Exists('$(RunicTextKeysFile)')" Text="$(RunicTextKeysFile) is missing; build Runic.CommandLine before packing it." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(RunicTextKeysFile)" PackagePath="translations/text-keys.json" />
    </ItemGroup>
  </Target>
  <Import Project="../../../eng/build/command-line.targets" />
</Project>
