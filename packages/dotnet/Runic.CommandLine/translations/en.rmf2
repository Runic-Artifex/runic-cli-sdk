# Built-in English text for the Runic.CommandLine framework keys (CommandTextKeys.All), catalog
# runic-command-line. Runic.CommandLine packs these sources as data under translations/; the
# Runic.Translations.CommandLine adapter compiles them. Each message is named after its key:
# hyphens are removed and the next letter is capitalized (help.show-help is help.showHelp), and
# each input is named after the key's argument. The text matches the English the framework writes
# without a resolver. tests/dotnet/Runic.CommandLine.TextCatalog.Tests checks all of this.
# faults.RCLI4001 has no message: Runic.CommandLine shows its diagnostics.prompt-* text, and
# would show a faults.RCLI4001 message instead of that text whenever it is unchanged in English.
help {
  usage = Usage
  commandPlaceholder = command
  optionsPlaceholder = options
  defaultCommand = default
  completion = Generate bash, zsh, fish or PowerShell completions
  commands = Commands
  arguments = Arguments
  options = Options
  showHelp = Show help
  showVersion = Show version
  outputFormat = Select output format
  jsonOutputAlias =
    .input {$option :string}
    {{Same as {$option} json}}
  jsonPayloadOutputAlias = Write the result as JSON
  responseFiles = Read more arguments from a file
  examples = Examples
  exitCodes = Exit codes
  required = required
  default = default
  choices = choices
  environment = env
  existing = existing
  pathKind {
    file = file
    directory = directory
  }
  minimum = min
  maximum = max
  requires = requires
  conflicts = conflicts
}
completion {
  invalidShell = Choose a completion shell: bash, zsh, fish or powershell.
}
prompts {
  selectHint = Arrow keys to move, Enter to confirm
  multiSelectHint = Arrow keys to move, Space to select, A for all, Enter to confirm
  yes = Yes
  no = No
  chooseOne =
    .input {$count :string}
    {{Enter a number from 1 to {$count}}}
  chooseMany =
    .input {$count :string}
    {{Enter numbers from 1 to {$count}, separated by commas}}
  answerYesNo =
    .input {$yes :string}
    .input {$no :string}
    {{Answer {$yes} or {$no}.}}
  required = An answer is required.
  cancelled = Cancelled
  done = Done
}
faults {
  RCLI4000 = The command was cancelled.
  RCLI5000 = The command could not be completed.
}
hints {
  RCLI5000 = Set RUNIC_COMMANDLINE_DEBUG=1 to write the exception to stderr.
  usage =
    .input {$command :string}
    {{Run "{$command}" for more information.}}
}
diagnostics {
  unknownOption =
    .input {$option :string}
    {{The option '{$option}' is not recognized.}}
  unknownOptionSuggestion =
    .input {$option :string}
    .input {$suggestion :string}
    {{The option '{$option}' is not recognized. Did you mean '{$suggestion}'?}}
  unknownCommand =
    .input {$command :string}
    {{The command '{$command}' is not recognized.}}
  unknownCommandSuggestion =
    .input {$command :string}
    .input {$suggestion :string}
    {{The command '{$command}' is not recognized. Did you mean '{$suggestion}'?}}
  missingOptionValue =
    .input {$option :string}
    {{The {$option} option requires a value.}}
  unexpectedOptionValue =
    .input {$option :string}
    {{The {$option} option does not take a value.}}
  missingArgument =
    .input {$argument :string}
    {{The {$argument} argument is missing.}}
  unexpectedArgument = Too many arguments were given.
  duplicateOption =
    .input {$option :string}
    {{The {$option} option was given more than once.}}
  unsupportedShortBundle = Short options cannot be combined; give each one separately.
  invalidOutputMode =
    .input {$option :string}
    {{{$option} must be human or json.}}
  conflictingOutputSelector =
    .input {$option :string}
    .input {$conflict :string}
    {{{$option} and {$conflict} both select the output format. Use one of them.}}
  transportOutputOptionCollision = The command line is invalid.
  missingRequiredOption =
    .input {$option :string}
    {{The {$option} option is required.}}
  unexpectedRootHelpArgument = The application's help takes no other arguments.
  responseFileUnreadable =
    .input {$file :string}
    {{The response file '{$file}' could not be read.}}
  responseFileInvalidUtf8 =
    .input {$file :string}
    {{The response file '{$file}' is not valid UTF-8.}}
  responseFileUnterminatedQuote =
    .input {$file :string}
    {{The response file '{$file}' has an unterminated quote.}}
  responseFileTooDeep =
    .input {$file :string}
    {{The response file '{$file}' is nested more than 16 levels deep.}}
  responseFileCycle =
    .input {$file :string}
    {{The response file '{$file}' includes itself.}}
  invalidEnvironmentValue =
    .input {$option :string}
    .input {$variable :string}
    {{{$variable} must be true/false, yes/no or 1/0 for {$option}.}}
  invalidChoice =
    .input {$parameter :string}
    .input {$choices :string}
    {{{$parameter} must be one of: {$choices}.}}
  invalidChoiceHidden =
    .input {$parameter :string}
    .input {$help :string}
    {{{$parameter} must be one of the choices shown in {$help}.}}
  invalidInteger =
    .input {$parameter :string}
    {{{$parameter} requires a whole number.}}
  invalidNumber =
    .input {$parameter :string}
    {{{$parameter} requires a number.}}
  invalidGuid =
    .input {$parameter :string}
    {{{$parameter} requires a GUID such as 0f8fad5b-d9cb-469f-a165-70867728950e.}}
  invalidBoolean =
    .input {$parameter :string}
    {{{$parameter} requires true or false.}}
  invalidValue =
    .input {$parameter :string}
    {{{$parameter} has an invalid value.}}
  validationFailed =
    .input {$parameter :string}
    {{{$parameter} has a value that failed validation.}}
  missingValue =
    .input {$parameter :string}
    {{{$parameter} requires a value.}}
  outOfRange =
    .input {$parameter :string}
    .input {$minimum :string}
    .input {$maximum :string}
    {{{$parameter} requires a number between {$minimum} and {$maximum}.}}
  belowMinimum =
    .input {$parameter :string}
    .input {$minimum :string}
    {{{$parameter} requires a number of at least {$minimum}.}}
  aboveMaximum =
    .input {$parameter :string}
    .input {$maximum :string}
    {{{$parameter} requires a number of at most {$maximum}.}}
  optionRequires =
    .input {$option :string}
    .input {$required :string}
    {{{$option} requires {$required}.}}
  optionConflict =
    .input {$option :string}
    .input {$conflict :string}
    {{{$option} cannot be combined with {$conflict}.}}
  invalidFilePath =
    .input {$parameter :string}
    {{{$parameter} requires a valid file path.}}
  invalidDirectoryPath =
    .input {$parameter :string}
    {{{$parameter} requires a valid directory path.}}
  fileNotFound =
    .input {$parameter :string}
    {{{$parameter} requires an existing file; check the path and permissions.}}
  directoryNotFound =
    .input {$parameter :string}
    {{{$parameter} requires an existing directory; check the path and permissions.}}
  environmentValueSource =
    .input {$parameter :string}
    .input {$variable :string}
    {{The value for {$parameter} came from environment variable {$variable}.}}
  promptRequiresTerminal =
    .input {$prompt :string}
    {{{$prompt} needs an answer, but the command is not running in an interactive terminal. Pass the value on the command line.}}
  promptJsonOutput =
    .input {$prompt :string}
    {{{$prompt} needs an answer, but JSON output never prompts. Pass the value on the command line.}}
  promptDisabled =
    .input {$prompt :string}
    {{{$prompt} needs an answer, but prompts are disabled. Pass the value on the command line.}}
}
