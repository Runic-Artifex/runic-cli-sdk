<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(RunicCommandLineDefaultTargetFramework)</TargetFramework>
    <RunicCommandLineShippingProject>true</RunicCommandLineShippingProject>
    <AssemblyName>Runic.CommandLine.Processes</AssemblyName>
    <RootNamespace>Runic.CommandLine.Processes</RootNamespace>
    <PackageId>Runic.CommandLine.Processes</PackageId>
    <Description>Bounded and cancellable local process execution for command-line clients.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Runic.CommandLine\Runic.CommandLine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PublicAPI.Unshipped.txt" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
